{
  "name": "@xja77/ap2-lib",
  "version": "0.0.0",
  "description": "AP2 Library - Agent Payments Protocol",
  "license": "MIT",
  "compilerOptions": {
    "lib": [
      "deno.window"
    ]
  },
  "tasks": {
    "dev": "deno run --watch src/main.ts",
    "test": "deno test --config deno.jsonc --allow-net --allow-read --coverage=coverage",
    "coverage": "deno coverage coverage",
    "coverage:clean": "rm -rf coverage",
    "coverage:detailed": "deno coverage coverage --detailed",
    "build": "deno run -A ./scripts/build.ts",
    "npm": "deno task build && cd npm && npm publish --access public",
    "jsr": "deno publish --no-check --allow-slow-types",
    "publish": "deno task jsr && deno task npm"
  },
  "exports": "./src/mod.ts",
  "imports": {
    "@noble/hashes": "jsr:@noble/hashes@^2.0.1",
    "@std/assert": "jsr:@std/assert@1",
    "bip66": "npm:bip66@^2.0.0",
    "currency-codes": "npm:currency-codes@^2.2.0",
    "jose": "npm:jose@^6.1.0"
  }
}