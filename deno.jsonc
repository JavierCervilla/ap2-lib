{
  "name": "@xja77/ap2-lib",
  "version": "1.3.3",
  "description": "AP2 Library - Agent Payments Protocol",
  "keywords": [
    "deno",
    "library",
    "payments",
    "AI",
    "agents",
    "AP2",
    "hacktoberfest"
  ],
  "license": "MIT",
  "compilerOptions": {
    "lib": [
      "deno.window"
    ]
  },
  "tasks": {
    "dev": "deno run --watch src/mod.ts",
    "check": "deno check --config deno.jsonc src/mod.ts",
    "test": "deno test --config deno.jsonc --allow-net --allow-read --coverage=coverage",
    "coverage": "deno coverage coverage",
    "coverage:clean": "rm -rf coverage",
    "coverage:detailed": "deno coverage coverage --detailed",
    "doc": "deno doc --html --name='AP2 Library' --output=docs src/mod.ts",
    "build": "deno run -A ./scripts/build.ts",
    "npm": "cd npm && npm publish --access public",
    "jsr": "deno publish --no-check --allow-slow-types",
    "publish": "deno task jsr && deno task npm"
  },
  "exports": "./src/mod.ts",
  "imports": {
    "@noble/hashes": "npm:@noble/hashes@^2.0.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "currency-codes": "npm:currency-codes@^2.2.0",
    "jose": "npm:jose@^6.1.0"
  },
  "devDependencies": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@^1.0.16"
  }
}